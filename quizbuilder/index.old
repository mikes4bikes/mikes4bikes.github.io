<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SCORM Quiz Generator</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- JSZip for creating the package -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <!-- FileSaver for downloading the package -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Summernote Lite (Rich Text Editor) -->
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>

    <style>
        body {
            overflow: hidden; /* Prevent full page scroll, let containers scroll */
        }
        .input-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 0.25rem;
            color: #374151;
            font-size: 0.85rem;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1; 
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1; 
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8; 
        }
        /* Overrides for Summernote */
        .note-editor .note-toolbar {
            background: #f3f4f6;
            border-bottom: 1px solid #e5e7eb;
        }
        .note-modal-footer {
            height: auto;
            padding: 10px;
        }
        
        /* Navigator Item Styles */
        .nav-item {
            transition: all 0.2s;
        }
        .nav-item.active {
            background-color: #eff6ff;
            border-left: 4px solid #2563eb;
            color: #1e40af;
        }
        .nav-item:hover:not(.active) {
            background-color: #f9fafb;
        }
        
        /* Toast Notification */
        #toast-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 100;
        }
        .toast {
            background: #333;
            color: white;
            padding: 10px 20px;
            border-radius: 5px;
            margin-top: 10px;
            opacity: 0;
            transition: opacity 0.3s;
        }
        .toast.show {
            opacity: 1;
        }
    </style>
</head>
<body class="bg-gray-100 h-screen flex flex-col font-sans text-gray-800">

    <!-- Navbar -->
    <nav class="bg-blue-600 text-white p-3 shadow-lg z-50 flex-shrink-0">
        <div class="max-w-full mx-auto flex justify-between items-center px-4">
            <h1 class="text-xl font-bold flex items-center"><i class="fas fa-box-open mr-2"></i> SCORM Builder</h1>
            <div class="flex items-center space-x-2">
                <!-- File Operations -->
                <div class="mr-4 flex space-x-1">
                    <button id="btnSaveLocal" class="bg-blue-700 hover:bg-blue-800 text-white px-3 py-1.5 rounded transition text-sm" title="Save to Browser Storage">
                        <i class="fas fa-save"></i> Save
                    </button>
                    <button id="btnExportJSON" class="bg-blue-700 hover:bg-blue-800 text-white px-3 py-1.5 rounded transition text-sm" title="Export as JSON">
                        <i class="fas fa-file-export"></i> Export
                    </button>
                    <button onclick="document.getElementById('importFile').click()" class="bg-blue-700 hover:bg-blue-800 text-white px-3 py-1.5 rounded transition text-sm" title="Import JSON">
                        <i class="fas fa-file-import"></i> Import
                    </button>
                    <input type="file" id="importFile" hidden accept=".json">
                </div>

                <div class="h-6 w-px bg-blue-400 mx-2"></div>

                <!-- Main Actions -->
                <button id="btnAddQuestion" class="bg-white text-blue-600 hover:bg-blue-50 px-4 py-1.5 rounded shadow transition font-semibold text-sm">
                    <i class="fas fa-plus"></i> Add Question
                </button>
                <button id="btnGenerate" class="bg-green-500 hover:bg-green-400 text-white px-4 py-1.5 rounded shadow transition font-bold text-sm">
                    <i class="fas fa-download"></i> Download SCORM
                </button>
            </div>
        </div>
    </nav>

    <!-- Main Workspace -->
    <div class="flex-1 flex overflow-hidden">
        
        <!-- Left Sidebar: Settings & Navigator -->
        <div class="w-80 bg-white border-r border-gray-200 flex flex-col flex-shrink-0 z-10 shadow-md">
            
            <!-- Settings Section -->
            <div class="p-4 border-b border-gray-200 bg-gray-50">
                <div class="flex justify-between items-center cursor-pointer" onclick="$('#settingsPanel').slideToggle()">
                    <h2 class="font-bold text-gray-700">Course Settings</h2>
                    <i class="fas fa-chevron-down text-gray-400 text-sm"></i>
                </div>
                <div id="settingsPanel" class="mt-3 space-y-3">
                    <div class="input-group">
                        <label>Title</label>
                        <input type="text" id="courseTitle" class="w-full border rounded p-1.5 text-sm focus:ring-1 focus:ring-blue-500 outline-none" value="My SCORM Quiz">
                    </div>
                    <div class="input-group">
                        <label>Passing Score (%)</label>
                        <input type="number" id="passingScore" class="w-full border rounded p-1.5 text-sm focus:ring-1 focus:ring-blue-500 outline-none" value="80" min="0" max="100">
                    </div>
                    <div class="input-group">
                        <label>Instructions</label>
                        <textarea id="courseInstructions" class="w-full border rounded p-1.5 text-sm h-16 focus:ring-1 focus:ring-blue-500 outline-none text-xs">Welcome to the quiz. Please answer all questions.</textarea>
                    </div>
                </div>
            </div>

            <!-- Navigator Header -->
            <div class="p-3 bg-gray-100 border-b border-gray-200 flex justify-between items-center">
                <h3 class="font-bold text-gray-600 text-sm uppercase tracking-wider">Questions</h3>
                <span class="bg-gray-200 text-gray-600 text-xs px-2 py-0.5 rounded-full" id="questionCountBadge">0</span>
            </div>

            <!-- Question Navigator List -->
            <div id="questionNavigator" class="flex-1 overflow-y-auto p-2 space-y-1">
                <!-- Nav items appended here -->
            </div>
        </div>

        <!-- Right Content: Active Question Editor -->
        <div class="flex-1 bg-gray-100 p-6 overflow-y-auto relative">
            <div id="questionsContainer" class="max-w-4xl mx-auto pb-20">
                <!-- Question Forms appended here -->
            </div>
            
            <!-- Empty State -->
            <div id="emptyState" class="absolute inset-0 flex flex-col items-center justify-center text-gray-400">
                <div class="bg-white p-8 rounded-full shadow-sm mb-4">
                    <i class="fas fa-layer-group text-4xl text-blue-200"></i>
                </div>
                <p class="text-lg font-medium text-gray-500">No question selected.</p>
                <button onclick="addQuestion()" class="mt-4 text-blue-600 hover:underline">Create your first question</button>
            </div>
        </div>
    </div>

    <!-- Startup Modal -->
    <div id="startupModal" class="fixed inset-0 bg-gray-900 bg-opacity-60 flex items-center justify-center z-[100] hidden backdrop-blur-sm">
        <div class="bg-white rounded-lg shadow-2xl p-8 max-w-md w-full text-center border border-gray-200">
            <div class="mb-5 flex justify-center">
                <div class="bg-blue-100 p-4 rounded-full">
                    <i class="fas fa-history text-3xl text-blue-600"></i>
                </div>
            </div>
            <h2 class="text-2xl font-bold mb-3 text-gray-800">Unsaved Progress Found</h2>
            <p class="text-gray-600 mb-8 leading-relaxed">We found a previously saved quiz in your browser storage. Would you like to restore it or start over with a fresh quiz?</p>
            <div class="flex flex-col space-y-3">
                <button id="btnLoadLocal" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-lg shadow-md transition transform active:scale-95 flex items-center justify-center">
                    <i class="fas fa-upload mr-3"></i> Restore Saved Quiz
                </button>
                <button id="btnStartNew" class="bg-white hover:bg-gray-50 text-gray-700 font-semibold py-3 px-4 rounded-lg border border-gray-300 transition flex items-center justify-center">
                    <i class="fas fa-plus mr-3 text-gray-400"></i> Start New Quiz
                </button>
            </div>
        </div>
    </div>

    <!-- Hidden Template for Question Card -->
    <template id="questionTemplate">
        <div class="question-card bg-white p-6 rounded-lg shadow-sm border border-gray-200 relative animate-fade-in" style="display:none;" data-id="">
            
            <div class="flex justify-between items-start mb-6 border-b pb-4">
                <h3 class="text-xl font-bold text-gray-800">Question <span class="q-number">1</span></h3>
                <button type="button" class="delete-q-btn text-gray-400 hover:text-red-600 px-3 py-1 hover:bg-red-50 rounded transition text-sm border border-transparent hover:border-red-100">
                    <i class="fas fa-trash-alt mr-1"></i> Delete Question
                </button>
            </div>

            <!-- Question Text -->
            <div class="mb-6 input-group">
                <label>Question Text</label>
                <textarea class="q-text w-full"></textarea>
            </div>

            <div class="grid grid-cols-2 gap-4 mb-6">
                <div class="input-group">
                    <label>Max Attempts</label>
                    <input type="number" class="q-attempts w-full border rounded p-2" value="1" min="1">
                </div>
            </div>

            <!-- Answers Area -->
            <div class="mb-6 bg-blue-50 p-4 rounded-lg border border-blue-100">
                <label class="block font-bold text-blue-800 mb-3">Answers</label>
                <div class="answers-list space-y-4">
                    <!-- Answers go here -->
                </div>
                <button class="add-answer-btn mt-4 text-sm font-bold text-white bg-blue-500 hover:bg-blue-600 px-4 py-2 rounded shadow-sm transition">
                    <i class="fas fa-plus-circle mr-1"></i> Add Answer Option
                </button>
            </div>

            <!-- Feedback -->
            <div class="grid grid-cols-1 gap-6 mt-6 pt-6 border-t">
                <div class="input-group">
                    <label class="text-green-700">Correct Feedback</label>
                    <textarea class="q-feedback-correct w-full"></textarea>
                </div>
                <div class="input-group">
                    <label class="text-red-700">Incorrect Feedback</label>
                    <textarea class="q-feedback-incorrect w-full"></textarea>
                </div>
            </div>
        </div>
    </template>

    <div id="toast-container"></div>

    <script src="scorm_builder.js"></script>
</body>
</html>